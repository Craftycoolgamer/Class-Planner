<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermsApp.TermDetailsPage"
             BackgroundColor="LightGray">

	<VerticalStackLayout Padding="10">

		<!-- Top Navigation Bar -->
		<Grid BackgroundColor="Gray" HeightRequest="50" Padding="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button Text="←" FontSize="18" BackgroundColor="Transparent" Clicked="OnBack"/>
			<Label Text="Term Title" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
			<Button Text="ADD" Grid.Column="2" BackgroundColor="Transparent" Clicked="OnAddCourse"/>
		</Grid>

		<!-- Separator Line -->
		<BoxView HeightRequest="1" BackgroundColor="Black" Margin="0,0,0,5"/>

		<!-- Term Input Section -->
		<Frame Padding="10" CornerRadius="5" BackgroundColor="White">
			<VerticalStackLayout>
				<Label Text="Term Title Input" FontAttributes="Bold" HorizontalOptions="Center"/>
				<BoxView HeightRequest="1" BackgroundColor="Black" Margin="0,5,0,5"/>

				<Grid ColumnDefinitions="Auto, *">
					<Label Text="Start Date" VerticalOptions="Center"/>
					<DatePicker Grid.Column="1"/>
				</Grid>

				<Grid ColumnDefinitions="Auto, *">
					<Label Text="End Date" VerticalOptions="Center"/>
					<DatePicker Grid.Column="1"/>
				</Grid>
			</VerticalStackLayout>
		</Frame>

		<!-- Course List Section -->
		<Frame Padding="10" CornerRadius="5" BackgroundColor="White">
			<CollectionView ItemsSource="{Binding Courses}" SelectionMode="Single" SelectedItem="{Binding SelectedCourse}">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Frame Padding="10"
                               CornerRadius="5"
                               BackgroundColor="{Binding ., Converter={StaticResource SelectedCourseConverter}}">
							<Label Text="{Binding}" VerticalOptions="Center" HorizontalOptions="Center"/>
						</Frame>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</Frame>

		<!-- Bottom Buttons -->
		<BoxView HeightRequest="1" BackgroundColor="Black" Margin="0,10,0,5"/>
		<Grid ColumnDefinitions="*, *" Padding="10">
			<Button Text="SAVE" Grid.Column="0" BackgroundColor="White" CornerRadius="5" Clicked="OnSave"/>
			<Button Text="DELETE" Grid.Column="1" BackgroundColor="White" CornerRadius="5" Clicked="OnDelete"/>
		</Grid>

	</VerticalStackLayout>
</ContentPage>