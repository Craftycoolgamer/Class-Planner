<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermsApp.MainPage"
             BackgroundColor="LightGray"
             Title="Home Page">

    <Shell.TitleView>
        <Grid>
            <Label Text="TERMS" VerticalOptions="Center" FontSize="18" TextColor="Black"/>
            <Button Text="ADD TERM" Clicked="AddTermClicked" HeightRequest="40"  HorizontalOptions="End" Margin="0,0,10,0" Padding="10"/>
        </Grid>
    </Shell.TitleView>


    <ScrollView >
        <VerticalStackLayout>
            <!-- Separator Line -->
            <BoxView HeightRequest="2" BackgroundColor="Black" Margin="0,0,0,10"/>

            <!-- Terms List -->
            <VerticalStackLayout x:Name="TermStack"  Margin="15,0,15,0" Spacing="10">
                <!-- Changed to programatically create Term buttons-->
            </VerticalStackLayout>
            
            
        </VerticalStackLayout>
    </ScrollView >


</ContentPage>
