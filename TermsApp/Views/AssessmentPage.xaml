<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermsApp.AssessmentPage"
             BackgroundColor="LightGray">

    <Shell.TitleView>
        <Grid>
            <Label Text="TERMS" VerticalOptions="Center" FontSize="18" TextColor="Black"/>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions=" * , Auto">
        <VerticalStackLayout>
            <!-- Top Navigation Bar -->
            <StackLayout Grid.Row="0">
                <!-- Separator Line -->
                <BoxView HeightRequest="2" BackgroundColor="Black" Margin="0,0,0,10"/>

                <!-- Assessment Info -->
                <Frame Padding="10" CornerRadius="5" BackgroundColor="White" Margin="15,0,15,10">
                    <VerticalStackLayout>
                        <Entry x:Name="AssessmentName" Placeholder="Assessment Name" FontAttributes="Bold" HorizontalOptions="Fill" HorizontalTextAlignment="Center"/>

                        <Grid ColumnDefinitions=" * , Auto">
                            <Label Text="Course Status:  " Grid.Column="0" FontAttributes="Bold"  Margin="18,0,0,0" VerticalTextAlignment="Center"/>
                            <Picker x:Name="TypePicker" Grid.Column="1" VerticalTextAlignment="Center" WidthRequest="200"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, * , auto" Margin="10,0,10,0">
                            <CheckBox x:Name="AssessmentStartNotify" IsChecked="False" Grid.Column="0" WidthRequest="30"/>
                            <Label Text="Notify         Start Date" VerticalOptions="Center" Grid.Column="1"/>
                            <DatePicker Grid.Column="2" x:Name="AssessmentStartDate"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, * , auto" Margin="10,0,10,0">
                            <CheckBox x:Name="AssessmentEndNotify" IsChecked="False" Grid.Column="0" WidthRequest="30"/>
                            <Label Text="Notify         End Date" VerticalOptions="Center" Grid.Column="1"/>
                            <DatePicker Grid.Column="2" x:Name="AssessmentEndDate"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </StackLayout>

        </VerticalStackLayout>
        <!-- Bottom Buttons -->
        <Grid Grid.Row="2">
            <Grid RowDefinitions="Auto, *">
                <BoxView HeightRequest="2" BackgroundColor="Black" Margin="0,10,0,5" Grid.Row="0"/>
                <Grid ColumnDefinitions="*, *" Margin="15,0,15,10" Grid.Row="1">
                    <Button Text="SAVE" Grid.Column="0" Margin="0,0,5,0" BackgroundColor="White" CornerRadius="5" Clicked="OnSave" TextColor="Black"/>
                    <Button x:Name="DeleteTerm" Text="DELETE" Grid.Column="1" Margin="5,0,0,0" BackgroundColor="White" CornerRadius="5" Clicked="OnDelete" TextColor="Black"/>
                </Grid>
            </Grid>
        </Grid>

    </Grid>

</ContentPage>
