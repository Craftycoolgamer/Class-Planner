<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermsApp.CoursePage"
             BackgroundColor="LightGray">
    
    <Shell.TitleView>
        <Grid>
            <Label Text="TERMS" VerticalOptions="Center" FontSize="18" TextColor="Black"/>
            <Button x:Name="AddAssessment" Text="ADD" Clicked="AddAssessmentClicked" HeightRequest="40" WidthRequest="80" HorizontalOptions="End" Margin="0,0,10,0"/>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions=" * , Auto">
        <ScrollView>
            <VerticalStackLayout>
                <!-- Top Navigation Bar -->
                <StackLayout Grid.Row="0">
                    <!-- Separator Line -->
                    <BoxView HeightRequest="2" BackgroundColor="Black" Margin="0,0,0,10"/>

                    <!-- Course Info Section -->
                    <Frame Padding="10" CornerRadius="5" BackgroundColor="White" Margin="15,0,15,10">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions=" * , Auto">
                                <Entry x:Name="CourseName" Placeholder="Enter Course Name" HorizontalOptions="Fill" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                <!--<Label Text="Course Status:" FontAttributes="Bold"/>
                                <Picker />-->
                            </Grid>
                            <Entry x:Name="CourseDescription" Placeholder="Enter Course Description" HorizontalOptions="Fill" HorizontalTextAlignment="Start" Margin="0,0,0,15"/>

                            <Label Text="Instructor Name:" FontAttributes="Bold"/>
                            <Entry x:Name="InstructorName" Placeholder="Enter Name"/>

                            <Label Text="Instructor Email:" FontAttributes="Bold"/>
                            <Entry x:Name="InstructorEmail" Placeholder="Enter Email" Keyboard="Email"/>

                            <Label Text="Instructor Phone:" FontAttributes="Bold"/>
                            <Entry x:Name="InstructorPhone" Placeholder="Enter Phone Number" Keyboard="Telephone"/>

                            <Grid ColumnDefinitions="Auto, * , auto" Margin="10,0,10,0">
                                <Label Text="Start Date" VerticalOptions="Center"/>
                                <DatePicker Grid.Column="2" x:Name="CourseStartDate"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto, * , auto" Margin="10,0,10,0">
                                <Label Text="End Date" VerticalOptions="Center" Grid.Column="0"/>
                                <DatePicker Grid.Column="2" x:Name="CourseEndDate"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                    <!-- Notes Section -->
                    <Frame Padding="10" CornerRadius="5" BackgroundColor="White" Margin="15,0,15,10">
                        <VerticalStackLayout>
                            <Label Text="Course Notes:" FontAttributes="Bold"/>
                            <Editor x:Name="NoteDetails" Placeholder="Enter Note" HeightRequest="100"/>
                            <HorizontalStackLayout>
                                <Button x:Name="ShareNotes" Text="SHARE NOTES" Clicked="ShareNoteClicked"/>
                                <Button x:Name="SaveNotes" Text="Save" Clicked="SaveNoteClicked"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </StackLayout>

                <!-- Course List Section -->
                <VerticalStackLayout x:Name="AssessmentStack"  Margin="15,0,15,0" Spacing="10">
                    <!-- Programatically create Assessment buttons-->
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2">
            <Grid RowDefinitions="Auto, *">
                <BoxView HeightRequest="2" BackgroundColor="Black" Margin="0,10,0,5" Grid.Row="0"/>
                <Grid ColumnDefinitions="*, *" Margin="15,0,15,10" Grid.Row="1">
                    <Button Text="SAVE" Grid.Column="0" Margin="0,0,5,0" BackgroundColor="White" CornerRadius="5" Clicked="OnSave" TextColor="Black"/>
                    <Button x:Name="DeleteAssessment" Text="DELETE" Grid.Column="1" Margin="5,0,0,0" BackgroundColor="White" CornerRadius="5" Clicked="OnDelete" TextColor="Black"/>
                </Grid>
            </Grid>
        </Grid>
        
    </Grid>
</ContentPage>